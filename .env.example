# Copy to .env.local and fill in. .env.local is gitignored.

# --- Azure DevOps ---
ADO_ORG_URL=https://dev.azure.com/jblprd
ADO_PROJECT=jemsmm
# Personal Access Token. Scopes: Code (read & write), Work Items (read).
# Never commit this and never paste it into a chat or issue.
ADO_PAT=

# --- TLS ---
# Needed on networks that terminate TLS (this one uses Zscaler). Node ignores
# the Windows certificate store, so it needs the roots as a PEM bundle.
# Generate with: npm run ca:export
# Do NOT set NODE_TLS_REJECT_UNAUTHORIZED=0 instead - that disables certificate
# verification for every request, including the ones carrying the PAT.
ADO_CA_BUNDLE=certs/windows-ca-bundle.pem

# --- Git ---
# Absolute path required. On the original dev machine `git` on PATH resolved to
# a zero-byte stub at C:\WINDOWS\system32\git that shadowed the real install.
GIT_EXECUTABLE=C:\Program Files\Git\cmd\git.exe
GIT_ASKPASS_SCRIPT=scripts/git-askpass.cmd

GIT_MIRROR_DIR=.repo-cache
GIT_WORKTREE_DIR=.worktrees

# Identity stamped as committer on commits this tool creates. Defaults to the
# PAT owner resolved from Azure DevOps if left blank.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# --- Database ---
DATABASE_URL=file:./prisma/dev.db

# --- Engine ---
# Concurrent backport jobs. Each one is a git worktree doing disk I/O.
BACKPORT_CONCURRENCY=3

# Serve fixture data instead of ADO. For UI work and tests only.
DEMO_MODE=false
